{
  "manifest_version": 3,
  "name": "Facebook Clipper",
  "version": "1.0.0",
  "description": "Captures posts you scroll past on Facebook (feed, groups, pages) into local storage for CSV export.",
  "author": "Venkata Bhattaram",
  "permissions": ["storage", "unlimitedStorage", "downloads"],
  "host_permissions": ["https://www.facebook.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Facebook Clipper (click to show/hide)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Pause/resume Facebook Clipper capturing"
    }
  }
}
